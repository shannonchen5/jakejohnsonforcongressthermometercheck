# Google Sheets — Thermometer Dashboard
# Spreadsheet must be publicly readable for either approach below.
VITE_GOOGLE_SHEET_ID=1zOhBXvgnwXZt3fXBQZIcQs1paCenvdiTMq6ja0GNOu4

# Preferred: Sheets API v4 (fresh reads; needs API key + quota)
VITE_GOOGLE_SHEETS_API_KEY=
VITE_GOOGLE_SHEET_RANGE=Thermometer Dashboard!A2:F

# Fallback CSV (no API key): Google gviz export by tab name
VITE_GOOGLE_SHEET_TAB=Thermometer Dashboard

# Poll interval in milliseconds (default: 5 minutes)
VITE_REFRESH_INTERVAL_MS=300000
